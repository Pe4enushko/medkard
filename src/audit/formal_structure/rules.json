      "rule_type": "diagnosis_check",
      "applies_to": {
        "visit_types": [
          "primary",
          "repeat"
        ],
        "specialties": [
          "pediatrics"
        ],
        "age_group": "child"
      },
      "targets": [
        "diagnosis_code",
        "diagnosis_text"
