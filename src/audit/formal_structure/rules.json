      "severity": "критичный",
      "source_ref": "приказ МЗ РФ от 13.05.2025 № 274н, прил. 1 (форма 025/у), раздел «Записи врачей-специалистов» (строки «Жалобы», «Анамнез заболевания, жизни», «Объективные данные», «Диагноз основного заболевания / код по МКБ»); прил. 2, п. 13",
      "verified_at": "2026-08-19"
    },
    {
      "rule_id": "plan_vs_result_separation",
      "source": "274n",
      "rule_type": "structure_defect",
      "applies_to": {
        "visit_types": [
          "primary",
          "repeat",
          "prophylactic"
        ],
        "specialties": [
          "all"
        ],
        "age_group": "all"
      },
      "targets": [
        "investigation_plan",
