  "rules": [
    {
      "rule_id": "visit_meta_required",
      "source": "274n",
      "rule_type": "required_field",
      "applies_to": {
        "visit_types": [
          "all"
        ],
        "specialties": [
          "all"
        ],
        "age_group": "all"
      },
      "targets": [
        "visit_date",
        "specialty",
        "patient_age",
        "patient_sex",
        "service_name"
      ],
      "expectation": "В записи должны быть идентифицируемы дата приёма, возраст, пол пациента и оказываемая услуга/тип визита.",
      "flag_code": "ОТСУТСТВУЮТ_МЕТАДАННЫЕ_ВИЗИТА",
      "severity": "критичный"
    },
    {
      "rule_id": "primary_core_sections_required",
      "source": "274n",
      "rule_type": "required_field",
      "applies_to": {
        "visit_types": [
          "primary"
        ],
        "specialties": [
          "all"
        ],
        "age_group": "all"
      },
      "targets": [
        "complaints",
        "anamnesis",
        "objective_exam",
        "diagnosis",
        "recommendations"
      ],
      "expectation": "Для первичного амбулаторного приёма должны быть отражены жалобы, анамнез, объективный осмотр, диагноз и итоговая тактика/рекомендации.",
      "flag_code": "ПЕРВИЧНЫЙ_ОТСУТСТВУЮТ_ОСНОВНЫЕ_РАЗДЕЛЫ",
      "severity": "критичный"
    },
    {
      "rule_id": "repeat_core_sections_required",
      "source": "274n",
      "rule_type": "required_field",
      "applies_to": {
        "visit_types": [
          "repeat"
        ],
        "specialties": [
          "all"
        ],
        "age_group": "all"
      },
      "targets": [
        "objective_exam",
        "diagnosis",
        "recommendations"
      ],
      "expectation": "Для повторного приёма должны быть отражены текущий статус пациента, объективный осмотр, диагноз/оценка состояния",
      "flag_code": "ПОВТОРНЫЙ_ОТСУТСТВУЮТ_ОСНОВНЫЕ_РАЗДЕЛЫ",
      "severity": "критичный"
    },
    {
      "rule_id": "repeat_needs_context_or_dynamics",
      "source": "274n",
      "rule_type": "conditional_required",
      "applies_to": {
        "visit_types": [
          "repeat"
        ],
        "specialties": [
          "all"
        ],
        "age_group": "all"
      },
      "targets": [
        "dynamics",
        "clinical_context"
      ],
      "expectation": "Для повторного приёма должна быть отражена динамика заболевания, эффект лечения или иной клинический контекст повторного визита.",
      "flag_code": "ПОВТОРНЫЙ_ОТСУТСТВУЕТ_ДИНАМИКА",
      "severity": "значительный",
      "source_ref": "приказ МЗ РФ от 13.05.2025 № 274н, прил. 1 (форма 025/у), раздел «Медицинское наблюдение в динамике» (строки «Жалобы», «Данные наблюдения в динамике», «Назначения (исследования, консультации)», «Лекарственные препараты, физиотерапия»); прил. 2, п. 14, п. 15",
      "verified_at": "2026-08-19"
    },
    {
      "rule_id": "diagnosis_required",
      "source": "274n",
      "rule_type": "required_field",
      "applies_to": {
        "visit_types": [
          "primary",
          "repeat"
        ],
        "specialties": [
          "all"
        ],
        "age_group": "child"
      },
      "targets": [
        "diagnosis"
      ],
      "expectation": "В записи должен быть указан хотя бы один диагноз или заключение по результату осмотра.",
      "flag_code": "ОТСУТСТВУЕТ_ДИАГНОЗ",
      "severity": "критичный"
    },
    {
      "rule_id": "diagnosis_should_be_supported",
      "source": "323-FZ",
      "rule_type": "diagnosis_check",
      "applies_to": {
        "visit_types": [
          "primary",
          "repeat"
        ],
        "specialties": [
          "all"
        ],
        "age_group": "all"
      },
      "targets": [
        "complaints",
        "anamnesis",
        "objective_exam",
        "diagnosis"
      ],
