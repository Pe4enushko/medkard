      "severity": "значительный",
      "source_ref": "Федеральный закон от 21.11.2011 № 323-ФЗ, ст. 70 ч. 5 (диагноз основан на всестороннем обследовании), ч. 6 (состав диагноза); ст. 2 п. 21",
      "verified_at": "2026-08-19"
    },
    {
      "rule_id": "management_should_follow_diagnosis",
      "source": "323-FZ",
      "rule_type": "consistency",
      "applies_to": {
        "visit_types": [
          "primary",
          "repeat"
        ],
        "specialties": [
          "all"
        ],
        "age_group": "all"
      },
      "targets": [
        "diagnosis",
        "recommendations",
        "treatment_plan",
        "investigation_plan"
      ],
      "expectation": "Назначения, обследования и рекомендации должны быть логически связаны с отражённым диагнозом и состоянием пациента.",
      "flag_code": "НАЗНАЧЕНИЯ_НЕ_СООТВЕТСТВУЮТ_ДИАГНОЗУ",
      "severity": "значительный",
      "source_ref": "Федеральный закон от 21.11.2011 № 323-ФЗ, ст. 37 ч. 1 п. 3 (клинические рекомендации), п. 4 (стандарты медицинской помощи); ст. 70 ч. 2",
      "verified_at": "2026-08-19"
    },
    {
      "rule_id": "objective_exam_required",
      "source": "274n",
      "rule_type": "required_field",
      "applies_to": {
        "visit_types": [
          "primary",
          "repeat",
          "prophylactic"
        ],
        "specialties": [
          "all"
        ],
        "age_group": "all"
      },
      "targets": [
        "objective_exam"
      ],
