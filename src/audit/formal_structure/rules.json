      "severity": "значительный"
    },
    {
      "rule_id": "followup_needed_for_nontrivial_case",
      "source": "323-FZ",
      "rule_type": "followup_check",
      "applies_to": {
        "visit_types": [
          "primary",
          "repeat"
        ],
        "specialties": [
          "all"
        ],
        "age_group": "all"
      },
      "targets": [
        "follow_up",
        "state",
        "diagnosis",
        "recommendations"
