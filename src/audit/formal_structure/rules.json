      "flag_code": "СМЕШАНЫ_ПЛАН_И_РЕЗУЛЬТАТЫ",
      "severity": "значительный"
    },
    {
      "rule_id": "placeholder_values_are_defect",
      "source": "274n",
      "rule_type": "structure_defect",
      "applies_to": {
        "visit_types": [
          "all"
        ],
        "specialties": [
          "all"
        ],
        "age_group": "all"
      },
      "targets": [
        "any_field"
      ],
      "expectation": "placeholder-значения, технический мусор и неинформативные заглушки считаются дефектом оформления записи",
      "flag_code": "ОБНАРУЖЕНЫ_ЗАГЛУШКИ",
      "severity": "значительный"
    },
    {
      "rule_id": "duplicate_semantic_blocks_are_defect",
      "source": "274n",
      "rule_type": "structure_defect",
      "applies_to": {
        "visit_types": [
          "all"
        ],
        "specialties": [
          "all"
        ],
        "age_group": "all"
      },
      "targets": [
        "any_field"
      ],
      "expectation": "Дублирование смысловых блоков или неоднократное заполнение одного и того же реквизита с конфликтом значений считается дефектом структуры.",
      "flag_code": "ДУБЛИРОВАНИЕ_СМЫСЛОВЫХ_БЛОКОВ",
      "severity": "незначительный"
    },
    {
      "rule_id": "service_specialty_visit_alignment",
