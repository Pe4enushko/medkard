OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Agent budgets and vLLM structured-output safeguards
AGENT_MAX_STEPS=12
AGENT_COMPACT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_COMPACT_MAX_TOOL_CALLS=4
AGENT_MAX_TOOL_RESULT_CHARS=12000
LLM_AGENT_TEMPERATURE=0.2
LLM_AGENT_MAX_OUTPUT_TOKENS=2048
LLM_RAW_MAX_OUTPUT_TOKENS=4096
LLM_OBSERVABILITY_PATH=logs/llm_observability.jsonl
VLLM_PARAMS_ENABLED=auto
VLLM_DISABLE_THINKING=true
VLLM_REPETITION_PENALTY=1.05
VLLM_TOP_K=50
VLLM_MIN_P=0.0
VLLM_REPETITION_DETECTION_ENABLED=true
VLLM_REPETITION_MAX_PATTERN_SIZE=20
VLLM_REPETITION_MIN_PATTERN_SIZE=3
VLLM_REPETITION_MIN_COUNT=4

# Optional separate vLLM pooling/score server for cross-encoder reranking
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_CANDIDATE_LIMIT=40
RERANK_TIMEOUT_SECONDS=10
RERANK_QUERY_TEMPLATE=<Instruct>: {instruction}\n<Query>: {query}
RERANK_DOC_TEMPLATE=<Document>: {doc}
RERANK_INSTRUCTION=Оцени, отвечает ли фрагмент клинических рекомендаций на клинический вопрос

# Deterministic diagnosis graph
DIAG_QUESTIONS_PER_ASPECT_MAX=4
DIAG_CANDIDATES_PER_QUESTION=40
DIAG_TOP_K_PER_QUESTION=5
DIAG_ASPECT_POOL_MAX_CHUNKS=20
DIAG_RETRIEVE_CONCURRENCY=8
DIAG_CITE_MAX_CHARS=300
DIAG_CRITERIA_SECTION_PATTERN=%критерии оценки качества%
DIAG_CRITERIA_MAX_CHUNKS=8

# Postgres — store password as plain text here; special characters are URL-encoded in code
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medkard
POSTGRES_USER=medkard_user
POSTGRES_PASSWORD=

# Must match the embedding model output dimension (Qwen/Qwen3-Embedding-4B = 1024)
EMBEDDING_DIM=1024
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Embedding provider: "openai" (AsyncOpenAI-compatible REST) or "st" (sentence-transformers, local)
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=

ALENKA_ONE_C_APPOINTMENTS_URL=
ALENKA_ONE_C_LOGIN=
ALENKA_ONE_C_PASSWORD=
ALENKA_ONE_C_TIMEOUT_SECONDS=25

MDS_ONE_C_APPOINTMENTS_URL=
MDS_ONE_C_LOGIN=
MDS_ONE_C_PASSWORD=
MDS_ONE_C_TIMEOUT_SECONDS=25

# Docker: bind the published pull-API port to this address only (e.g. the host's
# WireGuard interface IP) so the API is unreachable except through the tunnel.
WG_BIND_IP=
# Host port the pull-API container is published on (docker-compose.yml) — also
# the default port e2e/tests/*.py use when given "local" as the target URL.
API_PORT=8000
# Note: when running the API via docker-compose, POSTGRES_HOST must resolve from
# *inside* the container's network namespace — "localhost" will not reach a
# Postgres running on the host or in another container. Point it at the
# container/host address actually reachable from the api service's network.
